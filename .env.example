# 유니패스 OpenAPI 인증키 (화물통관진행정보)
# 발급: https://unipass.customs.go.kr 로그인 → My메뉴 → 서비스관리 → OpenAPI 사용관리
UNIPASS_API_KEY=

# 추적할 송장
TRACK_HBL=509799520393
TRACK_YEAR=2026
# CJ대한통운 운송장 (없으면 TRACK_HBL 사용)
TRACK_CJ_INVOICE=509799520393

# 카카오 나에게 보내기
# https://developers.kakao.com 앱 생성 후 REST API 키
KAKAO_REST_API_KEY=
# 플랫폼 키 > REST API 키 > 클라이언트 시크릿 (활성화된 경우)
KAKAO_CLIENT_SECRET=
# python scripts/kakao_login.py 로 1회 발급
KAKAO_REFRESH_TOKEN=

# 선택
# DRY_RUN=1
# FIRST_NOTIFY=0
# PUBLIC_PAGE_URL=https://ybs8625-cmd.github.io/customs-tracker/
